<Window
    x:Class="Lilium.ViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lilium">
    <Grid x:Name="RootGrid" Background="Black" Loaded="RootGrid_Loaded" KeyDown="RootGrid_KeyDown">
        <Grid x:Name="SpreadGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Image x:Name="LeftImage" Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <Image x:Name="RightImage" Grid.Column="1" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>
        <TextBlock x:Name="PageText" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Foreground="White" Opacity="0.7" />
    </Grid>
</Window>
