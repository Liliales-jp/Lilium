<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Lilium</RootNamespace>
    <AssemblyName>Lilium</AssemblyName>
    <Product>Lilium</Product>
    <Title>Lilium</Title>
    <Version>0.1.0-dev.20260922</Version>
    <ApplicationIcon>Assets\Lilium.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType Condition="'$(LiliumStorePackage)' != 'true'">None</WindowsPackageType>
    <EnableMsixTooling Condition="'$(LiliumStorePackage)' == 'true'">true</EnableMsixTooling>
    <SelfContained Condition="'$(LiliumStorePackage)' == 'true'">true</SelfContained>
    <WindowsAppSDKSelfContained Condition="'$(LiliumStorePackage)' == 'true'">false</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <EmbeddedResource Include="Strings\*.json" />
    <Content Include="Help.en.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Help.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Lilium.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Square44x44Logo.png" />
    <Content Include="Assets\Square150x150Logo.png" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>
</Project>
